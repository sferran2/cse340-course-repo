<%- include('partials/header') %>

    <main>
        <h2>CSE 340 Service Network!</h2>
        <p>Here are a few of our partner organizations:</p>
            
        <% organizations.forEach(org=> { %>
            <div class="org-card">
                <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> logo">
        
                <h3>
                    <%= org.name %>
                </h3>
        
                <p>
                    <%= org.contact_email %>
                </p>
        
                <p>
                    <%= org.description %>
                </p>
            </div>
            <% }) %>
        
    </main>

    <%- include('partials/footer') %>
    
